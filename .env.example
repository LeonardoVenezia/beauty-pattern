# IA del producto (NO es la del agente que programa).
# Documentacion de Refuseless (verificada 2026-11-09):
#   - API compatible con OpenAI Chat Completions.
#   - Base URL: https://api.refuseless.com/v1
#   - Modelo: deepseek-v4.1-flash-fast
# La clave se crea en la consola de Refuseless y empieza con abl_.
AI_PROVIDER=refuseless
AI_BASE_URL=https://api.refuseless.com/v1
AI_API_KEY=
AI_MODEL=deepseek-v4.1-flash-fast

# Opcional: modelos distintos por rol (vacio = usa AI_MODEL).
AI_MODEL_EXTRACTOR=
AI_MODEL_WRITER=
AI_MODEL_CRITIC=

# Robustez y costo (opcional).
AI_TIMEOUT_S=60
AI_MAX_RETRIES=2
AI_EXTRACTOR_SAMPLES=3
AI_CACHE_DIR=.ai-cache
AI_PRICE_INPUT_PER_MTOK=0.01
AI_PRICE_OUTPUT_PER_MTOK=0.08
# Precio del modelo segun la pagina oficial (2026-11-09): $0.01 / $0.08 por 1M tokens.

# Con FAKE_AI=1 no se hace ninguna llamada de red ni se gasta credito.
FAKE_AI=1

# API
DATABASE_PATH=data/tejedora.sqlite3
IMAGE_TTL_HOURS=24
MAX_UPLOAD_MB=12
RATE_LIMIT_PER_MINUTE=30

# Web / despliegue
# URL publica de la API que usa el navegador (se incrusta al construir la web).
NEXT_PUBLIC_API_URL=http://localhost:8000
# Origenes permitidos por CORS, separados por coma.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
